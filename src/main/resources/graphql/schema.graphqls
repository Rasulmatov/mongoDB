  type Query{
      getPost(id:ID!): Post
      getPosts :[Post]
  }

  type Mutation{
     createPost(title:String!, body: String, userId:Int!):Post
      updatePost( dto : UpdatePostDto ):Post
  }

  input UpdatePostDto{
      id: Int!
      title:String
      body:String
      rating:String
  }


  type Post{
      id:ID!
      title: String!
      body:String
      rating:Rating
      user:User
  }

  type User{
      id:ID!
      first_name:String
      last_name:String
      post: [Post]
  }

  type Rating{
      star: String
      rate:String
  }

